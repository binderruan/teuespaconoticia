name: Import Atende.net (Canoinhas)

on:
  schedule:
    - cron: "0 11 * * *"
  workflow_dispatch:

jobs:
  run:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"

      - run: npm init -y
      - run: npm pkg set type=module
      - run: npm i cheerio iconv-lite

      - run: node scripts/import-atende.js

      - name: Commit & push
        run: |
          git config user.name "teuespaco-bot"
          git config user.email "bot@teuespaco.com.br"
          git add noticias/posts.json noticias/_imports_atende.json noticias/*.md
          git commit -m "Import: Atende.net (Canoinhas)" || echo "Nada novo"
          git push
